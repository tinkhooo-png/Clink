<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/s_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="이번 달 지출" android:textColor="@color/widget_sub" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/s_month" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="0원" android:textColor="@color/widget_fg" android:textSize="24sp"
        android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" />
    <TextView android:id="@+id/s_today" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="오늘 0원" android:textColor="@color/widget_body" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="8dp" />
    <TextView android:id="@+id/s_add" android:layout_width="match_parent" android:layout_height="40dp"
        android:background="@drawable/widget_cat_bg" android:gravity="center" android:text="기록하기"
        android:textColor="@color/widget_weak_fg" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
