{
  "name": "simple-ledger",
  "version": "1.0.0",
  "description": "단순한 가계부: 기록·통계·설정",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis --publish never",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android"
  },
  "author": "Leo",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "firebase": "^13.2.0",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "productName": "심플 가계부",
  "private": true,
  "type": "module",
  "build": {
    "appId": "com.leo.simpleledger",
    "productName": "심플 가계부",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "SimpleLedger-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "심플 가계부"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.finance"
    }
  }
}
